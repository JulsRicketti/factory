#!/usr/bin/env bash
# factory — fire-and-forget Jira ticket → draft PR (+ optional watch+auto-fix)
#
# Usage:
#   factory <TICKET> [--watch] [--no-auto-fix] [--agent <name>] [--repo <name>] [--repo-agent <name>]
#
# Examples:
#   factory HUB-12345                                                # ticket → draft PR, return PR URL, done
#   factory HUB-12345 --watch                                        # same, then tail the watch loop with auto-fix
#   factory HUB-12345 --agent claude                                 # run the job via the claude CLI instead of copilot
#   factory HUB-12345 --repo hub                                     # force target repo, bypassing inference
#   factory HUB-12345 --repo-agent mui-migration-to-sprout                                          # one agent
#   factory HUB-12345 --repo-agent mui-migration-to-sprout,datatable-to-sprout-table                # multiple, comma-separated
#   factory HUB-12345 --repo-agent mui-migration-to-sprout --repo-agent flag-offbaarder              # multiple, repeated flag
#
# --repo / ticket directive `factory-repo: <name>`:
#   Forces the target repo to `~/Workspace/<name>` (e.g. `hub`, `hub-parcels`, `mc-parcels`).
#   Skips the autopilot's repo-inference ladder entirely. The CLI flag overrides
#   any directive in the Jira ticket.
#
# --repo-agent / ticket directive `factory-repo-agent: <name>[,<name>...]`:
#   Names one or more per-repo agents stored at `<target-repo>/.github/agents/<name>.agent.md`
#   that the factory must load and follow during the IMPLEMENT stage. Multiple agents
#   may be specified comma-separated, or by repeating the `--repo-agent` flag. When
#   multiple are active, the factory applies whichever agent matches each occurrence
#   (e.g. an MUI hit goes through the MUI agent; a DataTable hit goes through the
#   table-migration agent). The CLI list and the ticket directive are UNIONED — the
#   CLI flag does not override the ticket; both contribute. The active agent list is
#   recorded in the PR body under `## Agents used`.
#
# Agents (CLI on PATH):
#   copilot (default) | claude | codex
#   Register more by adding a case to resolve_agent_cmd() below.
#
# Ticket-level override:
#   If the Jira ticket body contains a line like `factory-agent: claude`, the
#   autopilot will exit with `FACTORY_BLOCKED: wrong-agent expected=claude` on
#   first run; this wrapper detects that and re-executes with the requested
#   agent. Set --agent explicitly to skip the detection round-trip.
#
# Env:
#   FACTORY_AGENT      — default agent (overridden by --agent)
#   FACTORY_REPO       — default target repo (overridden by --repo and by ticket directive)
#   FACTORY_REPO_AGENT — default repo-agent (overridden by --repo-agent and by ticket directive)
#   FACTORY_MODEL      — override model (passed to the agent's --model flag)
#   FACTORY_DRY_RUN    — 1 to print the agent command without running it
set -euo pipefail

FACTORY_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

TICKET="${1:-}"
if [[ -z "$TICKET" ]]; then
  echo "usage: factory <TICKET> [--watch] [--no-auto-fix]" >&2
  exit 2
fi
shift || true

WATCH=0
AUTO_FIX=1
AGENT="${FACTORY_AGENT:-copilot}"
REPO_AGENT="${FACTORY_REPO_AGENT:-}"
REPO_AGENT_FROM_CLI=0
TARGET_REPO="${FACTORY_REPO:-}"
TARGET_REPO_FROM_CLI=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --watch) WATCH=1; shift ;;
    --no-auto-fix) AUTO_FIX=0; shift ;;
    --agent) AGENT="${2:-}"; shift 2 ;;
    --repo) TARGET_REPO="${2:-}"; TARGET_REPO_FROM_CLI=1; shift 2 ;;
    --repo-agent)
      # Allow repeated flags: accumulate as comma-separated list.
      if [[ -z "$REPO_AGENT" ]]; then REPO_AGENT="${2:-}"; else REPO_AGENT="$REPO_AGENT,${2:-}"; fi
      REPO_AGENT_FROM_CLI=1; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# Map an agent name to the CLI invocation (array form, no -p yet).
# Each branch must end up with CMD=(...) representing the agent + standard flags.
resolve_agent_cmd() {
  case "$1" in
    copilot)
      CMD=(copilot --add-dir "$HOME/Workspace" --allow-all-tools --no-color)
      [[ -n "${FACTORY_MODEL:-}" ]] && CMD+=(--model "$FACTORY_MODEL")
      ;;
    claude)
      CMD=(claude --add-dir "$HOME/Workspace" --dangerously-skip-permissions)
      [[ -n "${FACTORY_MODEL:-}" ]] && CMD+=(--model "$FACTORY_MODEL")
      ;;
    codex)
      CMD=(codex exec --full-auto)
      [[ -n "${FACTORY_MODEL:-}" ]] && CMD+=(--model "$FACTORY_MODEL")
      ;;
    *)
      echo "unknown agent: $1 (supported: copilot, claude, codex)" >&2
      exit 2
      ;;
  esac
  command -v "${CMD[0]}" >/dev/null || { echo "${CMD[0]} CLI not installed or not on PATH" >&2; exit 1; }
}

# Pre-flight — fail fast, no prompts.
command -v gh >/dev/null || { echo "gh CLI not installed: brew install gh" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq not installed: brew install jq" >&2; exit 1; }
gh auth status >/dev/null 2>&1 || { echo "gh not authenticated: run 'gh auth login'" >&2; exit 1; }

PROMPT_FILE="$FACTORY_ROOT/.github/prompts/autopilot.prompt.md"
[[ -f "$PROMPT_FILE" ]] || { echo "missing prompt: $PROMPT_FILE" >&2; exit 1; }

# Build the one-shot prompt: full autopilot contract + the ticket key + current agent.
FULL_PROMPT="$(cat "$PROMPT_FILE")

---

TICKET = $TICKET
CURRENT_AGENT = $AGENT
TARGET_REPO = ${TARGET_REPO}
TARGET_REPO_LOCKED = ${TARGET_REPO_FROM_CLI}
REPO_AGENT = ${REPO_AGENT}
REPO_AGENT_LOCKED = ${REPO_AGENT_FROM_CLI}

Execute now. Do not ask questions. End with the FACTORY_RESULT line."

run_once() {
  resolve_agent_cmd "$AGENT"
  CMD+=(-p "$FULL_PROMPT")

  if [[ "${FACTORY_DRY_RUN:-0}" == "1" ]]; then
    printf '%q ' "${CMD[@]}"; echo
    exit 0
  fi

  echo "▶ factory: $TICKET  (autopilot via $AGENT, no questions)"
  echo "▶ logs will stream below; PR URL appears on the FACTORY_RESULT line at the end"
  echo "───────────────────────────────────────────────────────────────"

  LOG="$(mktemp -t factory-"$TICKET".XXXXXX)"
  # shellcheck disable=SC2024
  cd "$FACTORY_ROOT"
  if ! "${CMD[@]}" 2>&1 | tee "$LOG"; then
    echo "✖ factory: $AGENT exited non-zero; see $LOG" >&2
    exit 1
  fi
  # Match the result line even when wrapped in backticks / markdown / leading whitespace.
  RESULT="$(grep -oE 'FACTORY_(RESULT|BLOCKED)[^`]*' "$LOG" | tail -1 | sed -E 's/[[:space:]]+$//' || true)"
}

run_once

# Ticket-level agent override: autopilot emits FACTORY_BLOCKED: wrong-agent
# expected=<name> when it detects a `factory-agent:` directive in the ticket.
# Re-launch once with the requested agent.
if [[ "$RESULT" =~ ^FACTORY_BLOCKED:[[:space:]]*wrong-agent[[:space:]]+expected=([A-Za-z0-9_-]+) ]]; then
  REQUESTED="${BASH_REMATCH[1]}"
  if [[ "$REQUESTED" != "$AGENT" ]]; then
    echo "▶ factory: ticket requests agent=$REQUESTED — re-running"
    AGENT="$REQUESTED"
    FULL_PROMPT="${FULL_PROMPT/CURRENT_AGENT = */CURRENT_AGENT = $AGENT}"
    run_once
  fi
fi

if [[ -z "$RESULT" ]]; then
  echo "✖ factory: agent did not emit FACTORY_RESULT line; see $LOG" >&2
  exit 1
fi
if [[ "$RESULT" == FACTORY_BLOCKED:* ]]; then
  echo "✖ $RESULT" >&2
  exit 1
fi

echo
echo "───────────────────────────────────────────────────────────────"
echo "✔ $RESULT"

PR_URL="$(sed -n 's/.*pr=\([^ ]*\).*/\1/p'  <<<"$RESULT")"
REPO="$(  sed -n 's/.*repo=\([^ ]*\).*/\1/p' <<<"$RESULT")"
PR_NUM="${PR_URL##*/}"

if [[ "$WATCH" == "1" && -n "$PR_URL" && -n "$REPO" && -n "$PR_NUM" ]]; then
  echo
  echo "▶ factory: handing off to watch loop for $REPO#$PR_NUM"
  ON_CHANGE_ARGS=()
  if [[ "$AUTO_FIX" == "1" ]]; then
    FIX_PROMPT="Follow AGENTS.md stage 9. Respond to all review feedback on $REPO#$PR_NUM, push fixes, reply per thread, then run learn-from-pr. Do not ask questions. End with FACTORY_RESULT."
    ON_CHANGE_ARGS=(--on-change "cd '$FACTORY_ROOT' && copilot --add-dir '$HOME/Workspace' --allow-all-tools --no-color -p \"$FIX_PROMPT\"")
  fi
  exec "$FACTORY_ROOT/scripts/watch-pr.sh" "$REPO" "$PR_NUM" "${ON_CHANGE_ARGS[@]}"
fi
